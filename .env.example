# OpenRouter API Key (Get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_api_key_here

# Optional: Override the model used (Default: meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Qdrant configuration (these match the defaults in src/config.py and the
# qdrant_storage/ folder named in the README; change them only deliberately)
QDRANT_STORAGE_PATH=qdrant_storage
QDRANT_COLLECTION_NAME=pdf_documents

# Embeddings configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
